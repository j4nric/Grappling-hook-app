; Engine configuration file.
; Godot 4.4+ – Projekt "Grappling Cave"

config_version=5

[application]

config/name="Grappling Cave"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.04, 0.035, 0.05, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=false
; Overwritten by CI with the commit hash, shown in the HUD.
config/version="dev"

[autoload]

InputRouter="*res://scripts/input_router.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=false
; Needed so the tuning sliders react to touch. InputRouter ignores the
; emulated mouse events and reads the real touches instead.
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
; Smooth movement on 120 Hz screens and when frames drop: bodies are drawn
; between physics ticks. Jitter fix is not needed with interpolation.
common/physics_interpolation=true
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Browsers only support WebGL 2 -> Compatibility renderer for the web build.
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/texture_filter=0
