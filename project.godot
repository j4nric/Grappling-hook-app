; Engine configuration file.
; Godot 4.4+ – Projekt "Grappling Cave"

config_version=5

[application]

config/name="Grappling Cave"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"
; Overwritten by CI with the commit hash, shown in the HUD.
config/version="dev"

[autoload]

InputRouter="*res://scripts/input_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Browsers only support WebGL 2 -> Compatibility renderer for the web build.
renderer/rendering_method.web="gl_compatibility"
scaling_3d/scale=0.35
textures/canvas_textures/default_texture_filter=0
textures/default_filters/texture_filter=0
