extends Node
## Sound effects, driven by player, game and level signals. The sounds are
## generated by tools/gen_sounds.py. In the browser, audio starts with the
## first touch (Godot resumes the audio context on input).

const SOUNDS := ["throw", "hook", "miss", "zip", "land", "scrape", "lava", "checkpoint", "go", "finish"]

@export var player: CharacterBody3D
@export var game: Node
## Overall volume (0..1).
@export var volume := 0.8:
	set(value):
		volume = value
		if is_inside_tree():
			_apply_volume()
## Wind gets loud from this speed (m/s).
@export var wind_full_speed := 35.0
## How fast the wind volume follows the speed (1/s).
@export var wind_fade_speed := 4.0
## Wind pitch at rest and at full speed: faster sounds higher.
@export var wind_pitch_min := 0.8
@export var wind_pitch_max := 1.5
## Each hook in a flow chain bites a little higher (pitch per hook, up to 10).
@export var flow_pitch_step := 0.04

var _players := {}
var _wind: AudioStreamPlayer
var _checkpoint := Vector3.INF
var _wind_level := 0.0


func _ready() -> void:
	for sound_name in SOUNDS:
		var p := AudioStreamPlayer.new()
		p.stream = load("res://assets/sounds/%s.wav" % sound_name)
		p.max_polyphony = 3
		add_child(p)
		_players[sound_name] = p
	var wind_stream: AudioStreamWAV = load("res://assets/sounds/wind.wav").duplicate()
	wind_stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	wind_stream.loop_end = wind_stream.data.size() / 2
	_wind = AudioStreamPlayer.new()
	_wind.stream = wind_stream
	add_child(_wind)
	_apply_volume()

	player.hook_thrown.connect(play.bind("throw"))
	# Deferred: the game counts the flow in its own hook_attached handler.
	player.hook_attached.connect(func(_p: Vector3, _n: Vector3) -> void: _play_hook.call_deferred())
	player.deflected.connect(func(speed: float) -> void: play("scrape", clampf(speed / 30.0, 0.3, 1.0)))
	player.crushed.connect(play.bind("land"))
	player.hook_missed.connect(play.bind("miss"))
	player.rope_released.connect(func(reason: String) -> void:
		if reason == "zip":
			play("zip"))
	player.landed.connect(func(speed: float) -> void:
		if speed > 6.0:
			play("land", clampf((speed - 6.0) / 20.0, 0.3, 1.0)))
	game.run_started.connect(play.bind("go"))
	game.level_loaded.connect(_on_level_loaded)
	if game.level:
		_on_level_loaded(game.level)


func play(sound_name: String, loudness := 1.0, pitch := 1.0) -> void:
	var p: AudioStreamPlayer = _players[sound_name]
	p.volume_db = linear_to_db(maxf(volume * loudness, 0.0001))
	p.pitch_scale = pitch
	p.play()


func _play_hook() -> void:
	var flow: int = game.flow if "flow" in game else 0
	play("hook", 1.0, 1.0 + flow_pitch_step * clampi(flow - 1, 0, 10))


func _on_level_loaded(level: Level) -> void:
	_checkpoint = Vector3.INF
	level.finished.connect(play.bind("finish"))
	level.killed.connect(play.bind("lava"))
	level.checkpoint_reached.connect(func(point: Vector3) -> void:
		if not point.is_equal_approx(_checkpoint):
			_checkpoint = point
			play("checkpoint"))


func _process(delta: float) -> void:
	# The wind loop never stops (stopping and starting clicks); its volume
	# glides with the speed instead.
	if not _wind.playing:
		_wind.play()
	var target := clampf(player.velocity.length() / wind_full_speed, 0.0, 1.0)
	_wind_level = lerpf(_wind_level, target, 1.0 - exp(-wind_fade_speed * delta))
	_wind.volume_db = linear_to_db(maxf(volume * _wind_level * 0.6, 0.0001))
	_wind.pitch_scale = lerpf(wind_pitch_min, wind_pitch_max, _wind_level)


func _apply_volume() -> void:
	for p: AudioStreamPlayer in _players.values():
		p.volume_db = linear_to_db(maxf(volume, 0.0001))
